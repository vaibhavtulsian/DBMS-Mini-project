# ==============================================================================
# Environment Configuration Template
# Dual-Database Architecture: PostgreSQL (Transactional) + MySQL (Catalog)
# Copy this to .env.local for local development
# ==============================================================================

# PostgreSQL 16 (Transactional Engine: Orders, Inventory, Ledger, Stored Procedures)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wholesale_db

# MySQL 8.0 (Master Catalog Engine: Users, Brands, Products, SKUs, Specs, Reviews, Full-Text)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=wholesale_user
MYSQL_PASSWORD=wholesale_pass
MYSQL_DATABASE=wholesale_catalog

# JWT Secret for Session Cookies
JWT_SECRET=wholesale_distribution_secret_key_at_least_32_chars_long

# Server Port
PORT=3000
