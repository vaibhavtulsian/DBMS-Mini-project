# ==============================================================================
# Environment Configuration Template
# Dual-Database Architecture: PostgreSQL (Transactional) + MongoDB (Catalog)
# Copy this to .env.local for local development
# ==============================================================================

# PostgreSQL 16 (Transactional Engine: Orders, Inventory, Ledger, Stored Procedures)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wholesale_db

# MongoDB 7 (NoSQL Catalog Engine: Brands, Products, SKUs, Specs, Reviews, Audit)
MONGO_URI=mongodb://mongo:mongo@localhost:27017
MONGO_DATABASE=wholesale_catalog

# JWT Secret for Session Cookies
JWT_SECRET=wholesale_distribution_secret_key_at_least_32_chars_long

# Server Port
PORT=3000
