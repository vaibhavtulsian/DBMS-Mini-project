# ==============================================================================
# Environment Configuration Template
# PRD Section 9, 10 & 12
# Copy this to .env.local for local development
# ==============================================================================

# PostgreSQL Connection String with pgvector enabled
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wholesale_db

# JWT Secret for Session Cookies
JWT_SECRET=your_super_secret_jwt_key_must_be_at_least_32_characters_long

# Embedding Model (HuggingFace / Transformers.js local)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Server Port
PORT=3000
